<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Camera sul polso: appesa alla pinza (crawer_base), quindi si muove col braccio -->
    <joint name="wrist_camera_joint" type="fixed">
        <parent link="crawer_base"/>
        <child link="wrist_camera_link"/>
        <!-- 5cm sull'asse y, ruotato di 90 gradi sul pitch -->
        <origin xyz="0.0 0.1 0.03" rpy="0 -1.5708 0"/>
    </joint>

    <link name="wrist_camera_link">
        <visual>
            <geometry>
                <box size="0.01 0.03 0.03"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>

    <!-- Frame ottico: z avanti, x destra, y giù (convenzione delle immagini) -->
    <joint name="wrist_camera_optical_joint" type="fixed">
        <parent link="wrist_camera_link"/>
        <child link="wrist_camera_optical_frame"/>
        <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>

    <link name="wrist_camera_optical_frame"/>

    <!-- ==== Plugin Sensore ==== -->
    <gazebo reference="wrist_camera_link">
        <sensor name="wrist_camera" type="camera">
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.02</near>
                    <far>5</far>
                </clip>
            </camera>
            <always_on>1</always_on>
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            <topic>wrist_camera/image_raw</topic>
            <gz_frame_id>wrist_camera_optical_frame</gz_frame_id>
        </sensor>
    </gazebo>

</robot>